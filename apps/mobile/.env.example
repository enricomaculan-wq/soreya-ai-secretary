# Mobile Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_USE_DEMO_DATA=false
# Base URL of the Next.js web app for shared API routes.
# Simulator: http://localhost:3000 — physical device on LAN: http://YOUR_MAC_IP:3000 (e.g. http://192.168.20.177:3000)
EXPO_PUBLIC_WEB_APP_URL=

# Optional: required for EAS Build / push credentials
EXPO_PUBLIC_EAS_PROJECT_ID=

# Notifications
# Mobile-only flag. Server push delivery is controlled by apps/web ENABLE_PUSH_NOTIFICATIONS and EXPO_ACCESS_TOKEN.
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
