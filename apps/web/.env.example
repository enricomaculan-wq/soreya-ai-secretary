# GA4 (stesso Measurement ID di soreya.app e Ads Sentinel)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase
# Public keys are safe for browser initialization. Service role is server-only and must never be exposed client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: database password for `npm run setup:brain` (Supabase → Project Settings → Database)
SUPABASE_DB_PASSWORD=
# Or full connection string: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_URL=
NEXT_PUBLIC_USE_DEMO_DATA=false

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Demo access
DEMO_ACCESS_PASSWORD=

# Rate limiting (auto-enabled on production; set true to enable in local dev)
ENABLE_RATE_LIMIT=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Gmail
# Preferred: use dedicated Gmail OAuth credentials. Backward-compatible fallback: GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/email/google/callback

# Microsoft Calendar
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/calendar/microsoft/callback

# Microsoft Mail
# Preferred: use dedicated Microsoft Mail credentials. Backward-compatible fallback: MICROSOFT_CLIENT_ID/MICROSOFT_CLIENT_SECRET/MICROSOFT_TENANT_ID.
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_TENANT_ID=common
MICROSOFT_MAIL_REDIRECT_URI=http://localhost:3000/api/email/microsoft/callback

# WhatsApp
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Telegram
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_ENCRYPTION_KEY=
TELEGRAM_WEBHOOK_BASE_URL=

# Encryption
CALENDAR_TOKEN_ENCRYPTION_KEY=
EMAIL_TOKEN_ENCRYPTION_KEY=

# Notifications
EXPO_ACCESS_TOKEN=
ENABLE_PUSH_NOTIFICATIONS=false

# Sync
SYNC_SECRET=
ENABLE_SCHEDULED_SYNC=false
SYNC_LOOKBACK_DAYS=7
SYNC_LOOKAHEAD_DAYS=30
SYNC_EMAIL_LIMIT=25
SYNC_CALENDAR_LIMIT=250

# Execution
# Keep dry-run enabled until provider adapters and operational approvals are explicitly enabled.
EXECUTION_DRY_RUN=true
# Gmail send adapter is implemented (Google only). Requires gmail.send scope + Gmail reconnect.
ENABLE_EMAIL_EXECUTION=false
ENABLE_WHATSAPP_EXECUTION=false
ENABLE_TELEGRAM_EXECUTION=false
# Google Calendar write adapter is implemented (create event). Requires calendar.events scope + Calendar reconnect.
ENABLE_CALENDAR_EXECUTION=false

# Distributed rate limiting (optional; falls back to in-memory per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
